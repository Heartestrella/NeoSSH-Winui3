<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NeoSSH.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoSSH"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NeoSSH">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Global background image (behind all content) -->
        <Image x:Name="BackgroundImage" Grid.Row="0" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False" Canvas.ZIndex="0" />

        <TitleBar x:Name="TitleBar"
                  Title="NeoSSH"
                  Grid.Row="0" Canvas.ZIndex="1">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;"/>
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView" SelectionChanged="NavView_SelectionChanged"  Grid.Row="1" Canvas.ZIndex="1">
            <NavigationView.MenuItems>

                <NavigationViewItem x:Name="HomeNavItem" Tag="home_page">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Home"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="ssh_page">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="SSH Client"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent">
                <Frame.ContentTransitions>
                    <TransitionCollection />
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
