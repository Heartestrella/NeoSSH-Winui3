<Page
    x:Class="NeoSSH.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NeoSSH"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="新建会话"
                Click="NewSession_Click"
                Style="{StaticResource AccentButtonStyle}"
                Margin="0,0,0,24"/>

        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind Servers}"
                  SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ServerModel">
                    <Border Width="280"
                            Padding="16"
                            Margin="0,0,16,16"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">

                        <!-- 右键菜单：编辑 / 删除 -->
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="编辑"
                                               Icon="Edit"
                                               Tag="{x:Bind}"
                                               Click="EditServer_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="删除"
                                               Icon="Delete"
                                               Tag="{x:Bind}"
                                               Click="DeleteServer_Click"/>
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <StackPanel>

                            <!-- 服务器名称 + 状态灯 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind StatusBrush, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- IP 显示/隐藏切换按钮 -->
                            <Button Content="{x:Bind DisplayIp, Mode=OneWay}"
                                    Click="IpToggle_Click"
                                    DataContext="{x:Bind}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="0,4,0,16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>

                            <!-- CPU / 内存 -->
                            <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid>
                                        <ProgressRing IsIndeterminate="False"
                                                      Value="{x:Bind CpuUsage, Mode=OneWay}"
                                                      Maximum="100"
                                                      Width="48" Height="48"/>
                                        <TextBlock Text="CPU" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind CpuUsageText, Mode=OneWay}"
                                               FontSize="14" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid>
                                        <ProgressRing IsIndeterminate="False"
                                                      Value="{x:Bind RamUsage, Mode=OneWay}"
                                                      Maximum="100"
                                                      Width="48" Height="48"/>
                                        <TextBlock Text="MEM" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind RamUsageText, Mode=OneWay}"
                                               FontSize="14" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 存储空间 -->
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="存储空间" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{x:Bind DiskUsageText, Mode=OneWay}"
                                               FontSize="12" FontWeight="Medium"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar IsIndeterminate="False"
                                             Value="{x:Bind DiskUsage, Mode=OneWay}"
                                             Maximum="100"
                                             Height="6"
                                             CornerRadius="3"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
